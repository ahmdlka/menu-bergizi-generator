# python:3.11-slim lebih ringan dari full image
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies untuk build beberapa Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements dulu untuk layer cache
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download model sentence-transformers saat build image
# agar tidak download ulang setiap container restart
RUN python -c "from sentence_transformers import SentenceTransformer; \
               SentenceTransformer('all-MiniLM-L6-v2')"

# Copy source code
COPY . .

EXPOSE 8000

# 2 workers cukup untuk VPS 2-4 core; sesuaikan dengan spek server
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]